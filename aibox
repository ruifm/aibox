#!/usr/bin/env bash
# shellcheck shell=bash
set -euo pipefail

readonly VERSION="0.2.0"
readonly PROGRAM_NAME="aibox"
readonly SANDBOX_AIBOX_DIR="/run/aibox/bin"
readonly SANDBOX_AIBOX_PATH="${SANDBOX_AIBOX_DIR}/aibox"
readonly SANDBOX_RUNTIME_DIR="/run/aibox/runtime"

usage() {
    printf '%s\n' \
        "Usage:" \
        "  aibox [OPTIONS] [--] [COMMAND [ARGS...]]" \
        "  aibox -p|--dump-prompt" \
        "  aibox --help" \
        "  aibox --version" \
        "  --require-config PATH  Require a readable system agent policy file (repeatable)" \
        "  --hostname NAME        Set the sandbox display hostname (default: aibox)" \
        "" \
        "Runs COMMAND in a lightweight Bubblewrap sandbox:" \
        "  - current directory is mounted read/write at the same absolute path" \
        "  - host network is shared" \
        "  - \$HOME exists at the same path, but starts as sandbox-private tmpfs" \
        "  - selected agent/Nix/direnv state is mounted back in" \
        "  - inherited environment variables remain visible inside the sandbox" \
        "" \
        "Run from the repository root. If COMMAND is omitted, \$SHELL is used." \
        "Inside the sandbox, run 'aibox -p' to show agent guidance." \
        "" \
        "Examples:" \
        "  aibox codex" \
        "  aibox claude" \
        "  aibox copilot" \
        "  aibox hermes" \
        "  aibox omp" \
        "  aibox opencode" \
        "  aibox pi" \
        "  aibox ori codex" \
        "  aibox -- bash"
}

dump_prompt() {
    printf '%s\n' \
        "You are running inside an aibox sandbox." \
        "aibox public repo: https://github.com/ruifm/aibox" \
        "" \
        "- Treat the current working directory as the project workspace and the only intended writable project tree." \
        "- aibox mounts only the directory from which it starts. Project files above it are not visible. Start aibox from the repository root." \
        "- Network access is available." \
        "- AIBOX=1 identifies this environment for script behavior; it is not proof of isolation or authority." \
        "- Real agent state may be mounted, but broad host home/config state is not available." \
        "- Custom agent state path environment variables are removed. Use the default Codex, Claude Code, Copilot CLI, Hermes, OMP, OpenCode, and Pi paths." \
        "- D-Bus and host keyrings are not available. Use agent sign-in files or inherited token variables." \
        "- Do not install tools globally with apt, brew, npm -g, pipx, cargo install, or similar unless explicitly asked." \
        "- When a tool is missing, add it declaratively to the project's Nix devShell, then run direnv reload or nix develop as appropriate." \
        "- If the project has no .envrc and no Nix devShell file, bootstrap one with a minimal flake.nix devShell and an .envrc containing 'use flake'; run direnv allow once before adding tools." \
        "- Keep tooling changes in project files such as flake.nix, shell.nix, devshell.nix, or the existing local equivalent." \
        "- Generic \$HOME cache/config/local writes are sandbox-private unless a path is explicitly mounted by aibox." \
        "- XDG_RUNTIME_DIR is private temporary storage for this sandbox. Use it for sockets and active runtime state; its contents do not survive a restart." \
        "- You can run 'aibox -p' or 'aibox --dump-prompt' again to show these instructions."
}

die() {
    printf '%s: %s\n' "${PROGRAM_NAME}" "$*" >&2
    exit 1
}

need_cmd() {
    command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

add_dir() {
    local path=$1
    [[ "$path" == /* ]] || die "sandbox path is not absolute: $path"
    [[ "$path" == / ]] && return 0

    local parent
    parent=$(dirname "$path")
    add_dir "$parent"

    if [[ -z "${made_dirs[$path]+x}" ]]; then
        bwrap_args+=(--dir "$path")
        made_dirs[$path]=1
    fi
}

add_parent_dir() {
    local path=$1
    [[ "$path" == /* ]] || die "sandbox path is not absolute: $path"
    add_dir "$(dirname "$path")"
}

add_tmpfs() {
    local dest=$1
    [[ "$dest" == /* ]] || die "tmpfs destination is not absolute: $dest"
    add_parent_dir "$dest"
    if (($# > 1)); then
        bwrap_args+=(--perms "$2")
    fi
    bwrap_args+=(--tmpfs "$dest")
    made_dirs[$dest]=1
}

add_bind() {
    local src=$1
    local dest=${2:-$1}
    [[ -e "$src" || -L "$src" ]] || return 0
    [[ "$dest" == /* ]] || die "bind destination is not absolute: $dest"
    add_parent_dir "$dest"
    bwrap_args+=(--bind "$src" "$dest")
}

add_ro_bind() {
    local src=$1
    local dest=${2:-$1}
    [[ -e "$src" || -L "$src" ]] || return 0
    [[ "$dest" == /* ]] || die "bind destination is not absolute: $dest"
    add_parent_dir "$dest"
    bwrap_args+=(--ro-bind "$src" "$dest")
}

add_ro_bind_try() {
    local src=$1
    local dest=${2:-$1}
    [[ "$dest" == /* ]] || die "bind destination is not absolute: $dest"
    add_parent_dir "$dest"
    bwrap_args+=(--ro-bind-try "$src" "$dest")
}

add_symlink() {
    local target=$1
    local dest=$2
    [[ "$dest" == /* ]] || die "symlink destination is not absolute: $dest"
    add_parent_dir "$dest"
    bwrap_args+=(--symlink "$target" "$dest")
}

add_host_symlink_or_ro_bind() {
    local path=$1
    if [[ -L "$path" ]]; then
        add_symlink "$(readlink "$path")" "$path"
    else
        add_ro_bind "$path" "$path"
    fi
}

require_config() {
    local path=$1
    case "$path" in
        /etc/codex/?* | /etc/claude-code/?* | /etc/github-copilot/?* | /etc/hermes/?* | /etc/opencode/?*) ;;
        *) die "invalid required config path: $path" ;;
    esac
    case "/${path}/" in
        */./* | */../*) die "invalid required config path: $path" ;;
    esac
    required_configs+=("$path")
}

set_hostname() {
    local LC_ALL=C
    [[ ${#1} -le 64 && "$1" =~ ^[a-zA-Z0-9]([a-zA-Z0-9.-]*[a-zA-Z0-9])?$ ]] ||
        die "invalid hostname: use 1-64 ASCII letters, digits, dots, or hyphens, with a letter or digit at each end"
    sandbox_hostname=$1
}

parse_args() {
    while (($# > 0)); do
        case "$1" in
            --hostname)
                (($# >= 2)) || die "missing value for --hostname"
                set_hostname "$2"
                shift 2
                ;;
            --hostname=*)
                set_hostname "${1#*=}"
                shift
                ;;
            --require-config)
                (($# >= 2)) || die "missing value for --require-config"
                require_config "$2"
                shift 2
                ;;
            --require-config=*)
                require_config "${1#*=}"
                shift
                ;;
            -h | --help)
                usage
                exit 0
                ;;
            --version)
                printf '%s %s\n' "${PROGRAM_NAME}" "${VERSION}"
                exit 0
                ;;
            -p | --dump-prompt)
                dump_prompt
                exit 0
                ;;
            --)
                shift
                break
                ;;
            -*)
                die "unknown option: $1"
                ;;
            *)
                break
                ;;
        esac
    done

    command_args=("$@")
    if ((${#command_args[@]} == 0)); then
        command_args=("${SHELL:-/bin/sh}")
    fi
}

init_paths() {
    host_home=${HOME:?HOME must be set}
    host_home=$(realpath -m "$host_home")
    cwd_dest=$(pwd -P)
    cwd_src=$(realpath -e "$cwd_dest")
    cwd_dest=$cwd_src

    [[ "$cwd_dest" == /* ]] || die "current directory must resolve to an absolute path"
    [[ "$host_home" == /* ]] || die "HOME must resolve to an absolute path"

    if [[ "$cwd_dest" == / ]]; then
        die "refusing to bind / as the writable workspace; cd into a repository root first"
    fi

    if [[ "$cwd_dest" == "$host_home" ]]; then
        die "refusing to bind HOME as the writable workspace; cd into a repository root first"
    fi
}

resolve_program_path() {
    local source=${BASH_SOURCE[0]}
    if [[ -e "$source" || -L "$source" ]]; then
        program_path=$(realpath -e "$source")
        return 0
    fi

    local resolved
    resolved=$(command -v -- "$source") || die "could not resolve ${PROGRAM_NAME} path"
    program_path=$(realpath -e "$resolved")
}

ensure_host_dir() {
    local path=$1
    if [[ -L "$path" && ! -e "$path" ]]; then
        die "expected directory but found broken symlink: $path; remove or rename the conflicting path"
    fi
    if [[ -e "$path" && ! -d "$path" ]]; then
        die "expected directory but found non-directory: $path; remove or rename the conflicting path"
    fi
    mkdir -p "$path"
}

ensure_host_file() {
    local path=$1
    local initial_content=$2
    if [[ -L "$path" && ! -e "$path" ]]; then
        die "expected file but found broken symlink: $path; remove or rename the conflicting path"
    fi
    if [[ -e "$path" && ! -f "$path" ]]; then
        die "expected file but found non-file: $path; remove or rename the conflicting path"
    fi
    if [[ ! -e "$path" ]]; then
        ensure_host_dir "$(dirname "$path")"
        printf '%s\n' "$initial_content" >"$path"
    fi
}

prepare_host_state() {
    [[ -d "$host_home" ]] || die "HOME is not a directory: $host_home"

    local path
    for path in \
        "$host_home/.agents/skills" \
        "$host_home/.agents/plugins" \
        "$host_home/.codex" \
        "$host_home/.claude" \
        "$host_home/.copilot" \
        "$host_home/.hermes" \
        "$host_home/.omp" \
        "$host_home/.ori" \
        "$host_home/.pi" \
        "$host_home/.cache/copilot" \
        "$host_home/.cache/opencode" \
        "$host_home/.config/anthropic" \
        "$host_home/.config/opencode" \
        "$host_home/.local/share/direnv" \
        "$host_home/.local/share/opencode" \
        "$host_home/.local/state/opencode" \
        "$host_home/.cache/direnv"; do
        ensure_host_dir "$path"
    done

    ensure_host_file "$host_home/.claude.json" "{}"
}

build_bwrap_args() {
    bwrap_args=(
        --die-with-parent
        --unshare-all
        --share-net
        --unshare-user
        --disable-userns
        --new-session
        --hostname "$sandbox_hostname"
    )
    made_dirs=()

    bwrap_args+=(--proc /proc --dev /dev)
    add_tmpfs /tmp
    add_dir /var
    add_tmpfs /var/tmp
    add_tmpfs "$SANDBOX_RUNTIME_DIR" 0700
    add_dir "$host_home"
    add_tmpfs "$host_home/.cache"
    add_tmpfs "$host_home/.config"
    add_tmpfs "$host_home/.local"

    add_ro_bind /usr /usr
    local top
    for top in /bin /lib /lib64; do
        if [[ -L "$top" ]]; then
            add_symlink "$(readlink "$top")" "$top"
        else
            add_ro_bind "$top" "$top"
        fi
    done

    add_ro_bind /nix/store /nix/store
    add_bind /nix/var/nix/daemon-socket/socket /nix/var/nix/daemon-socket/socket
    add_ro_bind /nix/var/nix/profiles /nix/var/nix/profiles
    add_ro_bind "$host_home/.config/nix" "$host_home/.config/nix"

    if [[ -e "$host_home/.local/state/nix/profiles" || -L "$host_home/.local/state/nix/profiles" ]]; then
        add_ro_bind "$host_home/.local/state/nix/profiles" "$host_home/.local/state/nix/profiles"
    fi
    if [[ -e "$host_home/.nix-profile" || -L "$host_home/.nix-profile" ]]; then
        add_host_symlink_or_ro_bind "$host_home/.nix-profile"
    fi

    add_ro_bind "$program_path" "$SANDBOX_AIBOX_PATH"

    add_bind "$cwd_src" "$cwd_dest"

    local path
    for path in \
        "$host_home/.agents/skills" \
        "$host_home/.agents/plugins" \
        "$host_home/.codex" \
        "$host_home/.claude" \
        "$host_home/.claude.json" \
        "$host_home/.copilot" \
        "$host_home/.hermes" \
        "$host_home/.omp" \
        "$host_home/.ori" \
        "$host_home/.pi" \
        "$host_home/.cache/copilot" \
        "$host_home/.cache/opencode" \
        "$host_home/.config/anthropic" \
        "$host_home/.config/opencode" \
        "$host_home/.local/share/opencode" \
        "$host_home/.local/state/opencode"; do
        add_bind "$path" "$path"
    done

    for path in \
        "$host_home/.cache/omp" \
        "$host_home/.local/share/omp" \
        "$host_home/.local/state/omp"; do
        add_bind "$path" "$path"
    done

    add_ro_bind "$host_home/.config/direnv" "$host_home/.config/direnv"
    add_bind "$host_home/.local/share/direnv" "$host_home/.local/share/direnv"
    add_bind "$host_home/.cache/direnv" "$host_home/.cache/direnv"

    for path in \
        /etc/passwd \
        /etc/group \
        /etc/nsswitch.conf \
        /etc/hosts \
        /etc/resolv.conf \
        /etc/localtime \
        /etc/locale.conf; do
        add_ro_bind "$path" "$path"
    done

    for path in \
        /etc/nix \
        /etc/ssl \
        /etc/ca-certificates \
        /etc/pki; do
        add_ro_bind "$path" "$path"
        add_ro_bind "/etc/static/${path#/etc/}"
    done

    for path in \
        /etc/codex \
        /etc/claude-code \
        /etc/github-copilot \
        /etc/hermes \
        /etc/opencode; do
        add_ro_bind_try "$path" "$path"
        add_ro_bind "/etc/static/${path#/etc/}"
    done

    env_args=(
        --setenv AIBOX 1
        --setenv HOME "$host_home"
        --setenv XDG_CONFIG_HOME "$host_home/.config"
        --setenv XDG_CACHE_HOME "$host_home/.cache"
        --setenv XDG_DATA_HOME "$host_home/.local/share"
        --setenv XDG_STATE_HOME "$host_home/.local/state"
        --setenv XDG_RUNTIME_DIR "$SANDBOX_RUNTIME_DIR"
        --setenv PATH "${SANDBOX_AIBOX_DIR}:${PATH:-/usr/local/bin:/usr/bin:/bin}"
        --setenv TMPDIR /tmp
        --unsetenv SSH_AUTH_SOCK
        --unsetenv GPG_AGENT_INFO
        --unsetenv GNUPGHOME
        --unsetenv DBUS_SESSION_BUS_ADDRESS
        --unsetenv DOCKER_HOST
        --unsetenv KUBECONFIG
        --unsetenv CODEX_HOME
        --unsetenv CODEX_SQLITE_HOME
        --unsetenv CLAUDE_CONFIG_DIR
        --unsetenv ANTHROPIC_CONFIG_DIR
        --unsetenv COPILOT_HOME
        --unsetenv COPILOT_CACHE_HOME
        --unsetenv HERMES_HOME
        --unsetenv HERMES_MANAGED_DIR
        --unsetenv PI_CONFIG_DIR
        --unsetenv PI_CODING_AGENT_DIR
        --unsetenv PI_CODING_AGENT_SESSION_DIR
        --unsetenv PI_SERVER_DIR
        --unsetenv OPENCODE_CONFIG_DIR
        --unsetenv NIX_REMOTE
    )

    if [[ -S /nix/var/nix/daemon-socket/socket ]]; then
        env_args+=(--setenv NIX_REMOTE daemon)
    fi

    bwrap_args+=(--remount-ro / "${env_args[@]}" --chdir "$cwd_dest")
}

check_certificates() {
    local name value
    for name in SSL_CERT_FILE NIX_SSL_CERT_FILE; do
        [[ ${!name+x} ]] || continue
        value=${!name}
        if [[ ! -f "$value" || ! -r "$value" ]]; then
            printf >&2 'aibox: %s is not a readable certificate file inside the sandbox\n' "$name"
            exit 1
        fi
    done
}

sandbox_entry() {
    check_certificates
    local remaining=$1
    shift
    while ((remaining > 0)); do
        if [[ ! -f "$1" || ! -r "$1" ]]; then
            printf >&2 'aibox: required config is not a readable regular file: %q\n' "$1"
            exit 1
        fi
        shift
        remaining=$((remaining - 1))
    done
    exec "$@"
}

prepare_command() {
    if ((${#required_configs[@]} == 0)) && [[ -z ${SSL_CERT_FILE+x}${NIX_SSL_CERT_FILE+x} ]]; then
        return 0
    fi
    command_args=("$(realpath -e "$BASH")" --noprofile --norc -p -c
    "$(declare -f check_certificates sandbox_entry)"$'\nsandbox_entry "$@"'
    aibox "${#required_configs[@]}" "${required_configs[@]}" "${command_args[@]}")
}

print_command() {
    printf >&2 '%s: ' "${PROGRAM_NAME}"
    printf >&2 '%q ' bwrap "${bwrap_args[@]}" -- "${command_args[@]}"
    printf >&2 '\n'
}

main() {
    declare -ga command_args=()
    declare -ga required_configs=()
    declare -g host_home cwd_src cwd_dest program_path
    declare -g sandbox_hostname=aibox
    declare -ga bwrap_args=()
    declare -ga env_args=()
    declare -gA made_dirs=()

    parse_args "$@"

    need_cmd bwrap
    need_cmd dirname
    need_cmd mkdir
    need_cmd pwd
    need_cmd readlink
    need_cmd realpath

    init_paths
    resolve_program_path
    prepare_host_state
    build_bwrap_args
    prepare_command
    print_command

    bwrap "${bwrap_args[@]}" -- "${command_args[@]}"
}

main "$@"
